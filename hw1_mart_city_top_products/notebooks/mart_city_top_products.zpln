    {
      "text": "%spark.pyspark\ncity_revenue_window = (\n    Window\n    .partitionBy(\"city\")\n    .orderBy(F.col(\"revenue_sum\").desc(), F.col(\"product_id\").asc())\n)\n\nmart_city_top_products = (\n    aggregated\n    .withColumn(\"rn\", F.row_number().over(city_revenue_window))\n    .filter(F.col(\"rn\") <= 2)\n    .drop(\"rn\")\n)\n\nmart_city_top_products.orderBy(\"city\", F.col(\"revenue_sum\").desc()).show(truncate=False)\n",
      "user": "anonymous",
