    {
      "text": "%spark.pyspark\naggregated = (\n    enriched\n    .groupBy(\"city\", \"product_id\", \"product_name\")\n    .agg(\n        F.count(\"order_id\").alias(\"orders_cnt\"),\n        F.sum(\"qty\").alias(\"qty_sum\"),\n        F.sum(\"revenue\").alias(\"revenue_sum\"),\n    )\n)\n\naggregated.orderBy(\"city\", F.col(\"revenue_sum\").desc()).show(truncate=False)\n",
