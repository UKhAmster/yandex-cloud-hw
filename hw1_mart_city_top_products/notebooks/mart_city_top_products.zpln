    {
      "text": "%spark.pyspark\norders_with_revenue = orders.withColumn(\"revenue\", F.col(\"qty\") * F.col(\"price\"))\n\nenriched = (\n    orders_with_revenue\n    .join(users,    on=\"user_id\",    how=\"inner\")\n    .join(products, on=\"product_id\", how=\"inner\")\n)\n\nenriched.show(truncate=False)",
      "user": "anonymous",
      "dateUpdated": "2026-04-27T17:22:47+0000",
      "progress": 0,
      "config": {
        "editorSetting": {
